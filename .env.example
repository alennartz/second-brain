BRAIN_DB_PATH=data/brain.db
BRAIN_REASONING_MODEL=openai:gpt-4o-mini
# Optional OpenAI/OpenAI-compatible reasoning effort: none|minimal|low|medium|high|xhigh|max
# BRAIN_REASONING_EFFORT=low
BRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
BRAIN_EMBEDDING_DIMENSIONS=1536

# Optional OpenAI-compatible endpoints (for local test models).
# When set, use an `openai:` model string and leave the matching Foundry URL unset.
# BRAIN_REASONING_BASE_URL=http://jetson.ordernet:8082/v1
# BRAIN_EMBEDDING_BASE_URL=http://jetson.ordernet:8084/v1
# BRAIN_REASONING_KEY=none
# BRAIN_EMBEDDING_KEY=none

# Direct API:
OPENAI_API_KEY=sk-...
# Or for Anthropic direct: ANTHROPIC_API_KEY=sk-ant-...

# Azure Foundry (optional — per-concern, independent):
# BRAIN_REASONING_FOUNDRY_URL=https://your-reasoning-resource.services.ai.azure.com
# BRAIN_REASONING_AUTH=aad          # "aad" (DefaultAzureCredential) or "key" (API key)
# BRAIN_REASONING_KEY=              # explicit API key for reasoning Foundry endpoint;
#                                   # when omitted, SDK reads its default env var
#                                   # (AZURE_OPENAI_API_KEY for openai, ANTHROPIC_API_KEY for anthropic)
# BRAIN_EMBEDDING_FOUNDRY_URL=https://your-embedding-resource.services.ai.azure.com
# BRAIN_EMBEDDING_AUTH=key          # "aad" or "key"
# BRAIN_EMBEDDING_KEY=              # explicit API key for embedding Foundry endpoint;
#                                   # when omitted, SDK reads AZURE_OPENAI_API_KEY
#
# When *_FOUNDRY_URL is unset → PydanticAI passthrough (uses OPENAI_API_KEY etc. directly).
# When set + auth=key → routes through Foundry, authenticates with explicit *_KEY or SDK default env var.
# When set + auth=aad → routes through Foundry, authenticates with DefaultAzureCredential.

# Dream scheduler (optional):
# BRAIN_DREAM_IDLE_TIMEOUT_MINUTES=10  # minutes of inactivity before dreaming starts
# BRAIN_DREAM_DELAY_MULTIPLIER=1.5     # backoff multiplier between dream cycles
# BRAIN_DREAM_MAX_DELAY_MINUTES=720    # maximum delay between dream cycles (12 hours)
