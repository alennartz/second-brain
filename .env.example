# Bun server configuration
BRAIN_DB_PATH=data/brain.surreal
BRAIN_INGEST_MODEL=openai/gpt-4o-mini:medium
BRAIN_RECALL_MODEL=openai/gpt-4o-mini:medium
BRAIN_DREAM_MODEL=openai/gpt-4o-mini:low
BRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
BRAIN_EMBEDDING_DIMENSIONS=1536

# Intake limits and retry controls
# BRAIN_INTAKE_MAX_REQUEST_CHARS=100000
# BRAIN_INTAKE_CHUNK_CHARS=4000
# BRAIN_INTAKE_PROCESSING_BATCH_CHARS=12000
# BRAIN_INTAKE_WORKER_CONCURRENCY=1
# BRAIN_INTAKE_LEASE_SECONDS=300
# BRAIN_INTAKE_POLL_INTERVAL_SECONDS=1
# BRAIN_INTAKE_RETRY_BASE_DELAY_SECONDS=5
# BRAIN_INTAKE_RETRY_MAX_DELAY_SECONDS=3600
# BRAIN_INTAKE_SHUTDOWN_GRACE_SECONDS=60

# Dream scheduler
# BRAIN_DREAM_ENABLED=true
# BRAIN_DREAM_IDLE_TIMEOUT_MINUTES=10
# BRAIN_DREAM_DELAY_MULTIPLIER=1.5
# BRAIN_DREAM_MAX_DELAY_MINUTES=720
# BRAIN_DREAM_BATCH_SIZE=25

# Provider credentials. Pi reads standard provider environment variables.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible endpoints use the official OpenAI client for embeddings.
# OPENAI_BASE_URL=http://localhost:8084/v1
