# Copy this file to .env.mobile.local and fill in values on the development host.
# .env.mobile.local is ignored and must never contain repository-committed secrets.

# Wireless ADB connect address, not the host ADB server port and not the server URL.
# The port can change after restarting Android wireless debugging.
MOBILE_DEVICE=192.168.1.42:37123

# Trusted LAN address to which server-mobile binds. Keep this explicit.
MOBILE_SERVER_BIND_ADDRESS=192.168.1.10
# LAN address of this development machine, exposed by the server-mobile profile.
MOBILE_SERVER_URL=http://192.168.1.10:8200
MOBILE_DEVTOOLS_PORT=9100

# The mobile profile uses real models and overrides the database path to
# /data/brain.db inside its isolated mobile-brain-data volume.
BRAIN_DB_PATH=/data/brain.db
BRAIN_TEST_MODE=false
BRAIN_REASONING_MODEL=openai:gpt-4o-mini
BRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
BRAIN_EMBEDDING_DIMENSIONS=1536
# BRAIN_REASONING_EFFORT=low

# OpenAI direct API example:
OPENAI_API_KEY=replace-with-a-local-key
# Or set the provider variables required by your configured model.
# ANTHROPIC_API_KEY=replace-with-a-local-key

# Optional OpenAI-compatible endpoints:
# BRAIN_REASONING_BASE_URL=http://host.example:8082/v1
# BRAIN_EMBEDDING_BASE_URL=http://host.example:8084/v1
# BRAIN_REASONING_KEY=none
# BRAIN_EMBEDDING_KEY=none

# Optional Azure AI Foundry settings. Keep credentials in this ignored file.
# BRAIN_REASONING_FOUNDRY_URL=https://your-reasoning-resource.services.ai.azure.com
# BRAIN_REASONING_AUTH=key
# BRAIN_REASONING_KEY=replace-with-a-local-key
# BRAIN_EMBEDDING_FOUNDRY_URL=https://your-embedding-resource.services.ai.azure.com
# BRAIN_EMBEDDING_AUTH=key
# BRAIN_EMBEDDING_KEY=replace-with-a-local-key

# Pairing addresses and pairing codes are entered directly into adb pair once.
# Do not add them to this file.
