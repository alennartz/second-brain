# Second Brain local-production settings.
# Copy to deploy/deploy.env (gitignored) and fill in machine paths.

# Local Docker tag. Build it with: docker build -t second-brain:local .
BRAIN_IMAGE=second-brain:local

# systemd user service and container name.
BRAIN_DEPLOY_NAME=second-brain

# Keep the service on the local port used by the client.
BRAIN_DEPLOY_PORT=8100

# Application environment file. It contains provider credentials and must be
# readable only by this user. Include BRAIN_INGEST_MODEL, BRAIN_RECALL_MODEL,
# and BRAIN_DREAM_MODEL in provider/model:effort format. The service injects
# BRAIN_DB_PATH for the active database on the mounted data directory.
BRAIN_DEPLOY_ENV_FILE=/home/you/second-brain/.env

# Host directory mounted at /data.
BRAIN_DEPLOY_DATA_DIR=/home/you/second-brain/data

# Directory for rotating local archives. Keep it beside the data directory.
BRAIN_DEPLOY_BACKUP_DIR=/home/you/second-brain/backups

# Active database directory under BRAIN_DEPLOY_DATA_DIR.
BRAIN_DEPLOY_DB_NAME=brain.db
