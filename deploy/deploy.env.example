# Second Brain deployment settings — machine-specific.
# Copy to deploy/deploy.env (gitignored) and fill in real values.

# Fully qualified image reference with a pinned release tag. Never use
# latest — deploys must be reproducible and rollback-able.
BRAIN_IMAGE=ghcr.io/your-org/second-brain:v0.1.0

# systemd service and container name (host-specific).
BRAIN_DEPLOY_NAME=second-brain

# Host port the container's :8000 is published on (host-specific).
BRAIN_DEPLOY_PORT=8000

# Absolute path to the app .env file with BRAIN_* settings and API keys
# (host-specific; never committed).
BRAIN_DEPLOY_ENV_FILE=/home/you/second-brain/.env

# Host directory persisted as the SurrealDB data volume (host-specific).
BRAIN_DEPLOY_DATA_DIR=/home/you/second-brain/data
